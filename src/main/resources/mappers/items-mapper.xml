<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.itwill.semiproject.repository.ItemsDao">

    <!-- 아이템 조회 -->
    <select id="selectByItemsId" resultType="Items">
        SELECT * FROM items WHERE item_id = #{itemId} AND item_price = #{itemPrice}
    </select>
    
    <!-- 대여 및 판매 물품 아이템만 조회 -->
    <select id="selectAllItems" resultType="Items">
        SELECT * FROM items WHERE item_id >= 5
    </select>
      
</mapper>