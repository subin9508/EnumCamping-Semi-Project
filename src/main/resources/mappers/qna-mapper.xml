<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace: id를 저장해두는 공간 -->
<mapper namespace="com.itwill.semiproject.repository.QnADao">

    <!-- qna 테이블 전체 검색. 목록 보기 -->
    <select id="selectOrderByQnAPostIdDesc" resultType="QnA"> <!-- resultType: typeAliases의 별명. 리턴할 클래스 타입. -->
        select * from QnA order by q_post_id desc
    </select>
    
    <!-- qna 테이블에서 q_post_id(PK)로 검색. 상세보기. -->
    <select id="selectByQnAPostId" resultType="QnA">
        select * from QnA where q_post_id = #{q_post_id} <!-- mybatis 에서는 ? 대신 #{} 사용 -->
    </select>
    
    <!-- qna 테이블에 행 삽입. 새 글 작성. -->
    <!-- stmt.setString(1, "-") 와 같음 -->
    <insert id="insertQnA" >
        insert into QnA (q_title, q_content, q_user_id) 
        values (#{q_title}, #{q_content}, #{q_user_id})
    </insert>
    
    <!-- qna 테이블에서 해당 id의 제목, 내용, 수정시간 업데이트 -->
    <update id="updateQnA">
        update QnA 
        set q_title = #{q_title}, q_content = #{q_content}, modified_time = sysdate 
        where q_post_id = #{q_post_id}
    </update>
       
    <!-- qna 테이블에서 제목/내용/작성자로 검색 -->
    <select id = "searchQnA" resultType="QnA"> <!-- id = dao 메소드아이디  -->
        <bind name="q_searchKeyword" value="'%' + q_keyword + '%'" /> <!-- bind: 묶음. 0변수선언. like 검색할 때 % 붙인 것처럼, 검색어에 포함된 것을 찾음-->
        select * from QnA
        <where>
            <choose> <!-- swich case와 유사함. -->
                <!-- 속성의 값을 설정. 카테고리는 스트링. equals는 자바코드 아규먼트는 문자열로 인해 큰따옴표로 묶고
                   밖은 작은따옴표를 사용. t와 같으면 안쪽의 코드로 하겠다 -->
                   <!-- category 는  메소드 파라미터에서 getter 호출(param.getCategory) -->
                <when test='q_category.equals("qt")'>
                    upper(q_title) like upper(#{q_searchKeyword})
                </when> 
                <when test='q_category.equals("qc")'>
                    upper(q_content) like upper(#{q_searchKeyword})
                </when>
                <when test='q_category.equals("qtqc")'>
                    upper(q_title) like upper(#{q_searchKeyword})
                    or
                    upper(q_content) like upper(#{q_searchKeyword})
                </when>
                <when test='q_category.equals("qu")'>
                    upper(q_user_id) like upper(#{q_searchKeyword})                    
                </when>
            </choose>
        </where>
        order by q_post_id desc
    </select>

</mapper>