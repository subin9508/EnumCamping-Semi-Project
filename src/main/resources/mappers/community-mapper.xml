<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.itwill.semiproject.repository">

    <select id="selectAll" resultType="Notice">
        select * from notice order by post_id desc
    </select>

    <select id="selectByid" resultType="Notice">
        select * from notice where post_id = #{id}
    </select>

    <insert id="insertNotice">
        insert into notice (n_title, n_content) values (#{title},#{content})
    </insert>

    <delete id="deleteNotice">
        delete from posts where post_id = #{id}
    </delete>

</mapper>