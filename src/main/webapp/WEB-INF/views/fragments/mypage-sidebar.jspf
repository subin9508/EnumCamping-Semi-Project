<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" trimDirectiveWhitespaces="true"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<head>
    <c:url var="sidebarCSS" value="/css/sidebar.css" />
    <link rel="stylesheet" href="${sidebarCSS}">
</head>

<aside class="main-sidebar sidebar-dark-primary elevartion-4 sidebar">
    <div style="height: auto; width: 100%; border-bottom:1px solid black; margin: 5px; text-align: center;">
    <h3 id="title">마이페이지</h3>
    </div>
    <ul class="sidebar-menu">
        <li id="firstmenu">
            <c:url var="myPage" value="/user/myPage">
                <c:param name="userId" value="${user.userId}" />
            </c:url>
            <a href="${myPage}">내 정보</a>           
        </li>
        <li>
            <c:url var="reservationListUrl" value="/user/reservation_list">
                <c:param name="userId" value="${user.userId}" />
            </c:url>
            <a href="${reservationListUrl}">예약내역</a>
        </li>
        <li>
        	<c:url var="qnaListUrl" value="/user/qna_list">
                <c:param name="userId" value="${user.userId}" />
            </c:url>
           <a href="${qnaListUrl}">문의내역</a> 
        </li>
        <li>
			<a href="#" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">회원탈퇴</a>
        </li>
        </li>
    </ul>
</aside>


<!-- 회원 탈퇴 모달 -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteAccountModalLabel">회원 탈퇴</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>정말로 회원 탈퇴 페이지로 이동하시겠습니까?</p>
                <p>회원 탈퇴 시 같은 아이디로 60일 동안 재가입이 불가능합니다.</p>
                <p>탈퇴를 원하지 않으신다면, 취소 버튼을 눌러주세요.</p>
            </div>
            <div class="modal-footer">
                <!-- 탈퇴 버튼을 링크로 변경 -->
                <c:url var="userDeactivate" value="/user/deactivateUser">
                    <c:param name="userId" value="${user.userId}" />
                </c:url>
                <a href="${userDeactivate}" class="btn btn-danger">회원 탈퇴 페이지로 이동</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">취소</button>
            </div>
        </div>
    </div>
</div>


<!-- Bootstrap JS 추가 -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>