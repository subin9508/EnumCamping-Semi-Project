<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" trimDirectiveWhitespaces="true"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>

<header class="text-white text-center">
    

    <nav class="navbar navbar-expand-md" id="top">
        <div class="col-3 d-flex justify-content-center">
            <div id="weather-info">
                <p style="margin:0;">현재 날씨: <span id="sky"></span></p>
                <p style="margin:0;">기온: <span id="temp"></span>°C</p>
            </div>
        </div>

        <div class="col-6 navbar-nav d-flex justify-content-center">
            <a href="/semiproject/">
                <img alt="logo" src="images/logo_horizontal.jpg"
                    style="height: 60px; width: 200px;">
            </a>
        </div>
        
        <div class="col-3 d-flex justify-content-center">
            <ul class="navbar-nav ">
                <c:if test="${not empty signedInUser}">
                    <%-- 로그인 정보가 세션에 저장된 경우 --%>
                    <li class="nav-item"><c:url var="myPage"
                            value="/user/myPage">
                            <c:param name="userId"
                                value="${signedInUser}"></c:param>
                        </c:url> <a class="nav-link" href="${myPage}">마이페이지</a></li>
                    <li class="nav-item"><c:url var="signOutPage"
                            value="/user/signout" /> <a
                        class="nav-link" href="${signOutPage}"><span>${signedInUser}</span>
                            로그아웃</a></li>
                </c:if>

                <c:if test="${empty signedInUser}">
                    <li class="nav-item"><c:url var="signInPage"
                            value="/user/signin" /> <a class="nav-link"
                        href="${signInPage}">로그인</a></li>
                    <li class="nav-item"><c:url var="signUpPage"
                            value="/user/signup" /> <a class="nav-link"
                        href="${signUpPage}">회원가입</a></li>
                </c:if>
            </ul>
        </div>
    </nav>



</header>

<nav class="navbar navbar-expand-md main">
    <div class="container-fluid">
        <!-- 
            <c:url var="homePage"  value = "/"/>
            <a class="navbar-brand" href="${homePage}">Home</a>
             -->
        <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto" id="mainMenu">
                <li class="nav-item">
                <c:url value="/intro" var="introPage" />
                <a class="nav-link menu" aria-current="page" href="introduce">캠핑장 소개</a>
                    <ul class="subMenu">
                        <li>
                            <c:url value="/intro/" var="introPage1" />
                            <a class="nav-link" aria-current="page"
                            href="introduce">장점</a>
                        </li>
                        <li>
                            <c:url value="/intro" var="introPage2" />
                            <a class="nav-link" aria-current="page"
                            href="${introPage2}">편의시설</a>
                        </li>
                        <li>
                            <c:url value="/intro" var="introPage3" />
                            <a class="nav-link" aria-current="page"
                            href="facilityLayout">시설배치도</a>
                        </li>
                    </ul>
                    </li>
                <li class="nav-item"><c:url value="/info"
                        var="infoPage" /> <a class="nav-link  menu"
                    href="${infoPage}">이용안내</a>
                    <ul class="subMenu">
                        <li><c:url value="/info/" var="infoPage1" />
                            <a class="nav-link" aria-current="page"
                            href="${infoPage1}">이용시간</a></li>
                        <li><c:url value="/info" var="infoPage2" />
                            <a class="nav-link" aria-current="page"
                            href="${infoPage2}">예약방법안내</a></li>
                        <li><c:url value="/info" var="infoPage3" />
                            <a class="nav-link" aria-current="page"
                            href="${infoPage3}">판매/대여 물품</a></li>

                    </ul></li>
                <li class="nav-item"><c:url value="/reservation"
                        var="reservationPage" /> <a
                    class="nav-link  menu" href="${reservationPage}">예약</a></li>
                <li class="nav-item"><c:url value="/community"
                        var="communityPage" /> <a
                    class="nav-link  menu" href="${communityPage}">게시판</a>
                    <ul class="subMenu">
                        <li><c:url value="/community/"
                                var="communityPage1" /> <a
                            class="nav-link" aria-current="page"
                            href="${communityPage1}">공지사항</a></li>
                        <li><c:url value="/community"
                                var="communityPage2" /> <a
                            class="nav-link" aria-current="page"
                            href="${communityPage2}">일대일문의</a></li>
                        <li><c:url value="/community"
                                var="communityPage3" /> <a
                            class="nav-link" aria-current="page"
                            href="${communityPage3}">FAQ</a></li>
                        <li><c:url value="/community"
                                var="communityPage4" /> <a
                            class="nav-link" aria-current="page"
                            href="${communityPage4}">이용후기</a></li>
                    </ul></li>

            </ul>
        </div>
    </div>
</nav>