<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" trimDirectiveWhitespaces="true"%>
<%@ taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous">
</head>
<body>
    <div >
		<c:url var="footerCSS" value="/css/footer.css" />
		<link rel="stylesheet" href="${footerCSS}">
		<footer class="bg-secondary text-dark mt-5">
			<div class="container py-4">
				<div class="row gx-5">
					<div class="col-md-1 image-container">
						<a><img src="images/logo.png"></a>
					</div>
					<div class="col-md-3">
						<h5>주소</h5>
						<p>서울특별시 강남구 테헤란로 123</p>
					</div>
					<div class="col-md-3">
						<h5>연락처</h5>
						<p>전화: 02-1234-5678</p>
						<p>팩스: 02-1234-5679</p>
					</div>

					<div class="col-md-2">
						<h5>대표</h5>
						<p>홍길동</p>
					</div>

					<div class="col-md-3">
						<h5>이메일</h5>
						<p>
							<a href="mailto:enumcamping@gmail.com" class="text-white">enumcamping@gmail.com</a>
						</p>
					</div>
					<div class="footer-bottom text-center mt-3">
						<small>&copy; 2024 ENUM CAMPING. All rights reserved.</small>
					</div>
				</div>
			</div>
		</footer>
	</div>


    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>
</html>